{
  "schemaVersion": 1,
  "$defs": {
    "empty": { "type": "object", "additionalProperties": false },
    "principalId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "name": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 256 }, { "type": "null" }] },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpointBaseUrl", "model", "systemPrompt", "contextMessages"],
      "properties": {
        "endpointBaseUrl": { "type": "string", "maxLength": 2048 },
        "model": { "type": "string", "maxLength": 256 },
        "systemPrompt": { "type": "string", "maxLength": 16384 },
        "contextMessages": { "type": "integer", "minimum": 0, "maximum": 64 }
      }
    },
    "settingsView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["settings", "hasKey"],
      "properties": {
        "settings": { "$ref": "#/$defs/settings" },
        "hasKey": { "type": "boolean" }
      }
    },
    "keyView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hasKey"],
      "properties": { "hasKey": { "type": "boolean" } }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principalId", "name"],
      "properties": {
        "principalId": { "$ref": "#/$defs/principalId" },
        "name": { "$ref": "#/$defs/name" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principalId", "name", "bound"],
      "properties": {
        "principalId": { "$ref": "#/$defs/principalId" },
        "name": { "$ref": "#/$defs/name" },
        "bound": { "type": "boolean" }
      }
    },
    "candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agents"],
      "properties": {
        "agents": { "type": "array", "maxItems": 1024, "items": { "$ref": "#/$defs/candidate" } }
      }
    },
    "bindingView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent"],
      "properties": {
        "agent": { "anyOf": [{ "$ref": "#/$defs/agent" }, { "type": "null" }] }
      }
    },
    "statusError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "retryable": { "type": "boolean" }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "type": "string", "enum": ["unconfigured", "no_agent", "ready", "replying", "error"] },
        "agent": { "$ref": "#/$defs/agent" },
        "lastError": { "$ref": "#/$defs/statusError" }
      }
    },
    "chatEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "content"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "activity": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/activity" } }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "port", "ok"],
      "properties": {
        "package": { "type": "string", "minLength": 1, "maxLength": 64 },
        "port": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ok": { "type": "boolean" },
        "code": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "packageView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "name", "description", "available", "enabled", "major", "enabledMajor"],
      "properties": {
        "contract": { "$ref": "#/$defs/contractIdentity" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string", "maxLength": 1024 },
        "available": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "major": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "enabledMajor": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 65535 }, { "type": "null" }] }
      }
    },
    "contractIdentity": { "type": "string", "minLength": 1, "maxLength": 256 },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packages"],
      "properties": {
        "packages": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/packageView" } }
      }
    },
    "chat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries", "pending"],
      "properties": {
        "entries": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/chatEntry" } },
        "pending": { "type": "boolean" },
        "lastError": { "$ref": "#/$defs/statusError" },
        "failedActivity": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/activity" } }
      }
    }
  },
  "requests": {
    "agent.settings.get": {
      "request": { "$ref": "#/$defs/empty" },
      "response": { "$ref": "#/$defs/settingsView" }
    },
    "agent.settings.set": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["settings"],
        "properties": { "settings": { "$ref": "#/$defs/settings" } }
      },
      "response": { "$ref": "#/$defs/settingsView" }
    },
    "agent.key.set": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["apiKey"],
        "properties": { "apiKey": { "type": "string", "minLength": 1, "maxLength": 4096 } }
      },
      "response": { "$ref": "#/$defs/keyView" }
    },
    "agent.key.clear": {
      "request": { "$ref": "#/$defs/empty" },
      "response": { "$ref": "#/$defs/keyView" }
    },
    "agent.binding.candidates": {
      "request": { "$ref": "#/$defs/empty" },
      "response": { "$ref": "#/$defs/candidates" }
    },
    "agent.binding.set": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["principalId"],
        "properties": { "principalId": { "$ref": "#/$defs/principalId" } }
      },
      "response": { "$ref": "#/$defs/bindingView" }
    },
    "agent.binding.clear": {
      "request": { "$ref": "#/$defs/empty" },
      "response": { "$ref": "#/$defs/bindingView" }
    },
    "agent.status.get": {
      "request": { "$ref": "#/$defs/empty" },
      "response": { "$ref": "#/$defs/status" }
    },
    "agent.chat.get": {
      "request": { "$ref": "#/$defs/empty" },
      "response": { "$ref": "#/$defs/chat" }
    },
    "agent.chat.send": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["content"],
        "properties": { "content": { "type": "string", "minLength": 1, "maxLength": 8192 } }
      },
      "response": { "$ref": "#/$defs/chat" }
    },
    "agent.chat.clear": {
      "request": { "$ref": "#/$defs/empty" },
      "response": { "$ref": "#/$defs/chat" }
    },
    "agent.packages.get": {
      "request": { "$ref": "#/$defs/empty" },
      "response": { "$ref": "#/$defs/packages" }
    },
    "agent.packages.set": {
      "request": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false,
            "required": ["contract", "enabled", "major"],
            "properties": {
              "contract": { "$ref": "#/$defs/contractIdentity" },
              "enabled": { "const": true },
              "major": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["contract", "enabled"],
            "properties": {
              "contract": { "$ref": "#/$defs/contractIdentity" },
              "enabled": { "const": false }
            }
          }
        ]
      },
      "response": { "$ref": "#/$defs/packages" }
    }
  },
  "subscriptions": {
    "agent.status.changes": {
      "request": { "$ref": "#/$defs/empty" },
      "event": { "$ref": "#/$defs/status" }
    },
    "agent.chat.changes": {
      "request": { "$ref": "#/$defs/empty" },
      "event": { "$ref": "#/$defs/chat" }
    }
  }
}
